// ---------------------------------------------------------------- config
struct Cfg {
    QColor accent = QColor("#ff6fa5"), accent2 = QColor("#4fe3c1");
    int opacity = 82, radius = 18, refresh = 30, grid = 20, size = 100;   // size: widget scale in percent (100 = default), applied at launch
    QString font, user, avatar;
    bool locked = false, h24 = true, secs = true, mono = true, snap = true;
    QMap<QString, int> wop;     // per-widget opacity override (0 / missing = use global)
};
Cfg& cfg() { static Cfg c; return c; }
static const QStringList kIds{"launcher", "clock", "sysinfo", "github", "watching"};

// bump this whenever the default widget positions change: saved positions are cleared once so the new layout applies
static constexpr int kLayoutVersion = 7;

static const char* g_argv0 = "";
static int g_runSize = 100;          // widget size (percent) this process was started with
static bool g_ownScale = false;      // true when this process set QT_SCALE_FACTOR itself

// folder of the running exe (also works before QApplication exists)
static QString exeDir() {
#ifdef Q_OS_WIN
    wchar_t buf[MAX_PATH * 4]; DWORD n = GetModuleFileNameW(nullptr, buf, DWORD(MAX_PATH * 4));
    if (n) return QFileInfo(QString::fromWCharArray(buf, int(n))).absolutePath();
#endif
    if (QCoreApplication::instance()) return QCoreApplication::applicationDirPath();
    return QFileInfo(QString::fromLocal8Bit(g_argv0)).absolutePath();
}

// the size is applied at launch, so a new size = start a fresh copy of the app and quit this one
static void restartApp() {
    static bool going = false; if (going) return; going = true;
    QTimer::singleShot(250, [] {
        if (g_ownScale) qunsetenv("QT_SCALE_FACTOR");      // let the new copy work out its own scale
        QProcess::startDetached(QCoreApplication::applicationFilePath(), {});
        QCoreApplication::quit();
    });
}

// fonts: .ttf/.otf files in a "fonts" folder next to the exe (or in AppData if the exe folder is read-only) load automatically
static QString fontsDir() {
    QString d = exeDir() + "/fonts";
    QDir().mkpath(d);
    QFile t(d + "/.wd_write_test");
    if (t.open(QIODevice::WriteOnly)) { t.close(); t.remove(); return d; }
    d = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/fonts";
    QDir().mkpath(d);
    return d;
}
static void loadFonts() {
    for (const auto& dir : {exeDir() + "/fonts", QDir::currentPath() + "/fonts",
                            QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/fonts"})
        for (const auto& f : QDir(dir).entryList({"*.ttf", "*.otf"}, QDir::Files)) QFontDatabase::addApplicationFont(dir + "/" + f);
}
static QString preferredFont() {
    const QStringList have = QFontDatabase::families();
    for (auto f : {"Quicksand", "Nunito", "Comfortaa", "Varela Round", "Lexend", "Segoe UI Variable Display"})
        if (have.contains(f)) return f;
    return QApplication::font().family();
}

// ---- settings file: betterwidgets.ini next to the exe (hot-reloaded when you save it)
static QString cfgPath() {
    static QString p = [] {
        QString dir = exeDir();
        QFile t(dir + "/.wd_write_test");
        if (t.open(QIODevice::WriteOnly)) { t.close(); t.remove(); }
        else { dir = QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation); QDir().mkpath(dir); }
        return dir + "/betterwidgets.ini";
    }();
    return p;
}
static QString cfgText() {
    auto& c = cfg(); QString s;
    auto B = [](bool b) { return QString(b ? "true" : "false"); };
    auto put = [&](const QString& key, const QString& val, const QString& note) { s += "# " + note + "\n" + key + " = " + val + "\n\n"; };
    s += "# BetterWidgets settings\n# Edit this file and save it - the widgets update instantly, no restart needed.\n"
         "# Lines starting with # are comments. Delete a line to get its default back.\n\n";
    s += "# ================= look =================\n\n";
    put("accent", c.accent.name(), "highlight color (pink pill, badge)");
    put("accent2", c.accent2.name(), "second color (icons, graphs, buttons)");
    put("opacity", QString::number(c.opacity), "background opacity of ALL widgets, 20-100");
    put("radius", QString::number(c.radius), "corner radius, 0-40");
    put("size", QString::number(c.size), "widget size in percent, 50-200 (100 = default). the app restarts itself to apply a change");
    put("font", c.font, "font family name (empty = auto: Quicksand if installed)");
    put("mono", B(c.mono), "flat one-color app icons in the launcher");
    s += "# ================= layout =================\n\n";
    put("locked", B(c.locked), "true = widgets cannot be dragged");
    put("snap", B(c.snap), "snap widgets to a grid while dragging (hold ALT while dragging to ignore it)");
    put("grid", QString::number(c.grid), "grid size in pixels, 5-200");
    s += "# ================= clock / github =================\n\n";
    put("h24", B(c.h24), "24-hour clock");
    put("secs", B(c.secs), "show seconds");
    put("github_user", c.user, "your github username");
    put("github_refresh", QString::number(c.refresh), "github refresh interval in minutes, 5-600");
    put("avatar", c.avatar, "profile picture path (you can also click the picture in the widget)");
    s += "# ================= per-widget opacity =================\n"
         "# 0 or empty = use the global opacity above. Widgets: launcher, clock, sysinfo, github, watching\n\n";
    for (auto& id : kIds) s += "opacity." + id + " = " + QString::number(c.wop.value(id, 0)) + "\n";
    s += "\n";
    return s;
}
static void saveCfg() {
    QFile f(cfgPath());
    if (f.open(QIODevice::WriteOnly | QIODevice::Truncate | QIODevice::Text)) f.write(cfgText().toUtf8());
}
static QMap<QString, QString> readKv(const QString& path) {
    QMap<QString, QString> m; QFile f(path);
    if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) return m;
    for (auto line : QString::fromUtf8(f.readAll()).split('\n')) {
        line = line.trimmed();
        if (line.isEmpty() || line.startsWith('#') || line.startsWith(';')) continue;
        int i = line.indexOf('='); if (i < 1) continue;
        m[line.left(i).trimmed().toLower()] = line.mid(i + 1).trimmed();
    }
    return m;
}
static void loadCfgFile() {
    auto kv = readKv(cfgPath()); auto& c = cfg(); Cfg d;
    auto S = [&](const QString& k) { return kv.value(k); };
    auto I = [&](const QString& k, int def, int lo, int hi) { bool ok = false; int v = kv.value(k).toInt(&ok); return ok ? qBound(lo, v, hi) : def; };
    auto Bo = [&](const QString& k, bool def) {
        if (!kv.contains(k)) return def; QString v = kv[k].toLower();
        return v == "true" || v == "1" || v == "yes" || v == "on";
    };
    auto C = [&](const QString& k, const QColor& def) { QColor q(kv.value(k)); return q.isValid() ? q : def; };
    c.accent = C("accent", d.accent); c.accent2 = C("accent2", d.accent2);
    c.opacity = I("opacity", d.opacity, 20, 100); c.radius = I("radius", d.radius, 0, 40); c.size = I("size", d.size, 50, 200);
    QString f = S("font"); c.font = (f.isEmpty() || !QFontDatabase::families().contains(f)) ? preferredFont() : f;
    c.mono = Bo("mono", true); c.locked = Bo("locked", false); c.snap = Bo("snap", true); c.grid = I("grid", d.grid, 5, 200);
    c.h24 = Bo("h24", true); c.secs = Bo("secs", true);
    c.user = S("github_user"); c.refresh = I("github_refresh", 30, 5, 600); c.avatar = S("avatar");
    c.wop.clear();
    for (auto& id : kIds) { int v = kv.value("opacity." + id).toInt(); if (v > 0) c.wop[id] = qBound(5, v, 100); }
}
// first run: pick up whatever the old version stored in the registry, then write the file
static void loadRegistryCfg() {
    QSettings s; auto& c = cfg();
    c.accent  = QColor(s.value("accent", "#ff6fa5").toString());
    c.accent2 = QColor(s.value("accent2", "#4fe3c1").toString());
    c.opacity = s.value("opacity", 82).toInt();
    c.radius  = s.value("radius", 18).toInt();
    QString sf = s.value("font").toString();
    c.font    = (sf.isEmpty() || sf == QApplication::font().family()) ? preferredFont() : sf;
    c.locked  = s.value("locked", false).toBool();
    c.h24     = s.value("h24", true).toBool();
    c.secs    = s.value("secs", true).toBool();
    c.mono    = s.value("mono", true).toBool();
    c.user    = s.value("ghUser", "").toString();
    c.refresh = s.value("ghRefresh", 30).toInt();
    c.avatar  = s.value("avatar", "").toString();
}
static void initCfg() {
    if (QFile::exists(cfgPath())) loadCfgFile();
    else { loadRegistryCfg(); saveCfg(); }
}

// renamed from "widgetdeck": carry the old settings file and the saved state (positions, launcher list, shows) over once
static void migrateOldIni() {
    if (QFile::exists(cfgPath())) return;
    QString old = QFileInfo(cfgPath()).absolutePath() + "/widgetdeck.ini";
    if (QFile::exists(old)) QFile::copy(old, cfgPath());
}
static void migrateOldSettings() {
    QSettings now;
    if (now.value("migrated").toBool()) return;
    QSettings old("widgetdeck", "widgetdeck");
    if (now.allKeys().isEmpty()) for (auto& k : old.allKeys()) now.setValue(k, old.value(k));
    now.setValue("migrated", true);
}
// the widget size has to be known before QApplication is created, so it is read straight from the settings file
static int earlySize() {
    bool ok = false; int v = readKv(cfgPath()).value("size").toInt(&ok);
    return ok ? qBound(50, v, 200) : 100;
}


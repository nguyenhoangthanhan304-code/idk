// ---------------------------------------------------------------- helpers
[[maybe_unused]] static QString sh(const QString& p, const QStringList& a) {
    QProcess x; x.start(p, a); x.waitForFinished(1500);
    return QString::fromUtf8(x.readAllStandardOutput()).trimmed();
}
[[maybe_unused]] static double ramGB() {
#ifdef Q_OS_MAC
    return sh("sysctl", {"-n", "hw.memsize"}).toDouble() / 1073741824.0;
#elif defined(Q_OS_LINUX)
    QFile f("/proc/meminfo");
    if (f.open(QIODevice::ReadOnly))
        for (auto& t : f.readLine().split(' ')) { bool ok; double k = t.toDouble(&ok); if (ok) return k / 1048576.0; }
    return 0;
#elif defined(Q_OS_WIN)
    MEMORYSTATUSEX m; m.dwLength = sizeof(m);
    return GlobalMemoryStatusEx(&m) ? m.ullTotalPhys / 1073741824.0 : 0;
#else
    return 0;
#endif
}

// square image with rounded corners, cropped from the top (good for posters / avatars)
static QPixmap roundedSq(const QPixmap& src, int sz, int r) {
    qreal dpr = qApp->devicePixelRatio(); int S = int(sz * dpr);
    QPixmap out(S, S); out.fill(Qt::transparent); out.setDevicePixelRatio(dpr);
    QPainter p(&out); p.setRenderHint(QPainter::Antialiasing); p.setRenderHint(QPainter::SmoothPixmapTransform);
    QPainterPath path; path.addRoundedRect(0, 0, sz, sz, r, r); p.setClipPath(path);
    QPixmap s = src.scaled(S, S, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
    p.drawPixmap(QRect(0, 0, sz, sz), s, QRect((s.width() - S) / 2, 0, S, S));
    return out;
}
// placeholder tile: first letter on an accent gradient
static QPixmap letterTile(const QString& s, int sz, int r) {
    qreal dpr = qApp->devicePixelRatio();
    QPixmap out(int(sz * dpr), int(sz * dpr)); out.setDevicePixelRatio(dpr); out.fill(Qt::transparent);
    QPainter p(&out); p.setRenderHint(QPainter::Antialiasing);
    QLinearGradient g(0, 0, sz, sz); g.setColorAt(0, cfg().accent); g.setColorAt(1, cfg().accent2);
    p.setBrush(g); p.setPen(Qt::NoPen); p.drawRoundedRect(0, 0, sz, sz, r, r);
    QFont f = p.font(); f.setPixelSize(sz / 2); f.setBold(true); p.setFont(f); p.setPen(QColor("#12302e"));
    p.drawText(QRect(0, 0, sz, sz), Qt::AlignCenter, s.left(1).toUpper());
    return out;
}
static QIcon magnifier() {
    QPixmap p(32, 32); p.fill(Qt::transparent);
    QPainter g(&p); g.setRenderHint(QPainter::Antialiasing);
    g.setPen(QPen(QColor("#555"), 2.4, Qt::SolidLine, Qt::RoundCap));
    g.drawEllipse(QPointF(14, 14), 7, 7); g.drawLine(QPointF(19, 19), QPointF(25, 25));
    return QIcon(p);
}
// tiny "+" / "<" glyph icons for the launcher's "add app" and "back" rows
static QIcon symbolIcon(const QString& ch, int sz = 22) {
    qreal dpr = qApp->devicePixelRatio(); int S = int(sz * dpr);
    auto mk = [&](const QColor& col) {
        QPixmap p(S, S); p.setDevicePixelRatio(dpr); p.fill(Qt::transparent);
        QPainter g(&p); g.setRenderHint(QPainter::Antialiasing); g.setPen(QPen(col, 2.2, Qt::SolidLine, Qt::RoundCap));
        if (ch == "+") { g.drawLine(QPointF(sz * .3, sz * .5), QPointF(sz * .7, sz * .5)); g.drawLine(QPointF(sz * .5, sz * .3), QPointF(sz * .5, sz * .7)); }
        else { g.drawLine(QPointF(sz * .6, sz * .28), QPointF(sz * .38, sz * .5)); g.drawLine(QPointF(sz * .38, sz * .5), QPointF(sz * .6, sz * .72)); }
        return p;
    };
    QIcon ic; ic.addPixmap(mk(cfg().accent2), QIcon::Normal); ic.addPixmap(mk(QColor("#1a1a1a")), QIcon::Selected); return ic;
}

// ---------------------------------------------------------------- installed applications
struct App { QString name, target, icon, custom, orig; };   // target: .app / .lnk path, or Exec line on linux; custom: user-picked icon file

static QStringList appRoots() {
#ifdef Q_OS_MAC
    return {"/Applications", "/System/Applications", "/System/Applications/Utilities", QDir::homePath() + "/Applications"};
#elif defined(Q_OS_WIN)
    return {qEnvironmentVariable("ProgramData") + "/Microsoft/Windows/Start Menu/Programs",
            qEnvironmentVariable("APPDATA") + "/Microsoft/Windows/Start Menu/Programs"};
#else
    return {"/usr/share/applications", "/usr/local/share/applications", QDir::homePath() + "/.local/share/applications",
            "/var/lib/flatpak/exports/share/applications", QDir::homePath() + "/.local/share/flatpak/exports/share/applications",
            "/var/lib/snapd/desktop/applications"};
#endif
}

// only installed applications - never documents or random files
static QList<App> scanApps() {
    QList<App> out; QSet<QString> seen;
    auto add = [&](const QString& name, const QString& target, const QString& icon = {}) {
        QString n = name.trimmed(), k = n.toLower();
        if (n.isEmpty() || seen.contains(k)) return;
        for (auto bad : {"uninstall", "readme", "release notes", "documentation", "license"}) if (k.contains(bad)) return;
        seen.insert(k); out.push_back({n, target, icon});
    };
#ifdef Q_OS_MAC
    std::function<void(const QString&, int)> walk = [&](const QString& dir, int depth) {
        for (auto& fi : QDir(dir).entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot, QDir::Name)) {
            if (fi.suffix() == "app") add(fi.completeBaseName(), fi.absoluteFilePath());
            else if (depth > 0) walk(fi.absoluteFilePath(), depth - 1);
        }
    };
    for (auto& r : appRoots()) walk(r, 1);
#elif defined(Q_OS_WIN)
    for (auto& r : appRoots()) {
        QDirIterator it(r, {"*.lnk"}, QDir::Files, QDirIterator::Subdirectories);
        while (it.hasNext()) {
            it.next(); QFileInfo t(it.fileInfo().symLinkTarget());
            if (!t.filePath().isEmpty() && t.isDir()) continue;   // folder shortcuts are not apps
            add(it.fileInfo().completeBaseName(), it.filePath());
        }
    }
    // apps without a start-menu shortcut: look in the usual install folders (only added if not already found above)
    const QList<QPair<QString, QString>> known = {
        {"Visual Studio Code", qEnvironmentVariable("LOCALAPPDATA") + "/Programs/Microsoft VS Code/Code.exe"},
        {"Visual Studio Code", qEnvironmentVariable("ProgramFiles") + "/Microsoft VS Code/Code.exe"},
        {"Visual Studio Code", qEnvironmentVariable("ProgramFiles(x86)") + "/Microsoft VS Code/Code.exe"},
    };
    for (auto& k : known) if (QFileInfo::exists(k.second)) add(k.first, k.second);
#else
    static const QRegularExpression fieldCode("%[a-zA-Z]");
    for (auto& r : appRoots()) {
        QDirIterator it(r, {"*.desktop"}, QDir::Files, QDirIterator::Subdirectories);
        while (it.hasNext()) {
            QFile f(it.next()); if (!f.open(QIODevice::ReadOnly)) continue;
            QString name, exec, icon; bool hide = false, isApp = true, inEntry = false;
            for (auto line : QString::fromUtf8(f.readAll()).split('\n')) {
                line = line.trimmed();
                if (line.startsWith('[')) { inEntry = line == "[Desktop Entry]"; continue; }
                if (!inEntry) continue;
                if (line.startsWith("Name=") && name.isEmpty()) name = line.mid(5);
                else if (line.startsWith("Exec=")) exec = line.mid(5).remove(fieldCode).trimmed();
                else if (line.startsWith("Icon=")) icon = line.mid(5);
                else if (line == "NoDisplay=true" || line == "Hidden=true") hide = true;
                else if (line.startsWith("Type=")) isApp = line.mid(5) == "Application";
            }
            if (!hide && isApp && !exec.isEmpty()) add(name, exec, icon);
        }
    }
#endif
    std::sort(out.begin(), out.end(), [](const App& a, const App& b) { return a.name.toLower() < b.name.toLower(); });
    return out;
}

static void launchApp(const App& a) {
#ifdef Q_OS_MAC
    QProcess::startDetached("open", {a.target});
#elif defined(Q_OS_WIN)
    if (a.target.startsWith("shell:")) QProcess::startDetached("explorer.exe", {a.target});   // microsoft store apps
    else QDesktopServices::openUrl(QUrl::fromLocalFile(a.target));
#else
    auto args = QProcess::splitCommand(a.target);
    if (!args.isEmpty()) { auto p = args.takeFirst(); QProcess::startDetached(p, args); }
#endif
}

// Turns any app icon into a flat one-color glyph on a transparent background, with cut-out gaps.
static QImage glyphMask(const QPixmap& src) {
    QImage im = src.toImage().convertToFormat(QImage::Format_ARGB32);
    const int W = im.width(), H = im.height();
    QHash<int, int> hist; qint64 opaque = 0; double lumSum = 0;
    for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x) {
        QRgb c = im.pixel(x, y); if (qAlpha(c) < 128) continue;
        ++opaque; lumSum += qGray(c);
        ++hist[((qRed(c) >> 4) << 8) | ((qGreen(c) >> 4) << 4) | (qBlue(c) >> 4)];
    }
    QImage out(W, H, QImage::Format_ARGB32); out.fill(0);
    if (!opaque) return out;
    int best = 0, bestN = 0;
    for (auto it = hist.begin(); it != hist.end(); ++it) if (it.value() > bestN) { bestN = it.value(); best = it.key(); }
    double frac = double(bestN) / opaque, mean = lumSum / opaque;
    int br = ((best >> 8) & 15) * 16 + 8, bg = ((best >> 4) & 15) * 16 + 8, bb = (best & 15) * 16 + 8;
    auto smooth = [](double e0, double e1, double v) { double t = qBound(0.0, (v - e0) / (e1 - e0), 1.0); return t * t * (3 - 2 * t); };
    for (int y = 0; y < H; ++y) {
        auto* o = reinterpret_cast<QRgb*>(out.scanLine(y));
        for (int x = 0; x < W; ++x) {
            QRgb c = im.pixel(x, y); int a = qAlpha(c); if (!a) continue;
            double k;
            if (frac >= 0.3) {
                double dr = qRed(c) - br, dg = qGreen(c) - bg, db = qBlue(c) - bb;
                double d = std::sqrt(dr * dr + dg * dg + db * db) / 441.0, g = smooth(0.18, 0.38, d);
                k = frac >= 0.5 ? 1.0 - g : g;
            } else k = smooth(mean - 25, mean + 25, qGray(c));
            o[x] = qRgba(255, 255, 255, int(a * k));
        }
    }
    return out;
}
static QPixmap tintMask(const QImage& mask, const QColor& col, int px, qreal dpr) {
    QImage t = mask.scaled(px, px, Qt::KeepAspectRatio, Qt::SmoothTransformation);
    QPainter p(&t); p.setCompositionMode(QPainter::CompositionMode_SourceIn); p.fillRect(t.rect(), col); p.end();
    QPixmap out = QPixmap::fromImage(t); out.setDevicePixelRatio(dpr); return out;
}
// the app's own icon, or the one the user picked, as a flat one-color icon
static QIcon appIcon(const App& a, int sz) {
    QPixmap px;
    if (!a.custom.isEmpty()) px = QPixmap(a.custom);
    if (px.isNull()) {
        QIcon ic;
#ifdef Q_OS_LINUX
        ic = QIcon::fromTheme(a.icon);
        if (ic.isNull() && QFileInfo::exists(a.icon)) ic = QIcon(a.icon);
#else
        static QFileIconProvider prov;
        QFileInfo fi(a.target);
        QString real = fi.symLinkTarget();      // use the real exe's icon, not the shortcut-arrow icon of the .lnk
        if (!a.target.startsWith("shell:")) ic = prov.icon((real.isEmpty() || !QFileInfo::exists(real)) ? fi : QFileInfo(real));
#endif
        if (!ic.isNull()) px = ic.pixmap(QSize(64, 64));
    }
    if (px.isNull()) return QIcon(letterTile(a.name, sz, 6));
    if (!cfg().mono) return QIcon(px);
    qreal dpr = qApp->devicePixelRatio(); int S = int(sz * dpr);
    QImage m = glyphMask(px); QIcon out;
    out.addPixmap(tintMask(m, cfg().accent2, S, dpr), QIcon::Normal);
    out.addPixmap(tintMask(m, QColor("#1a1a1a"), S, dpr), QIcon::Selected);   // dark glyph on the pink pill
    return out;
}

// ---------------------------------------------------------------- base glass widget
class Glass;
QList<Glass*> g_widgets;

class Glass : public QWidget {
public:
    QString id; QPoint defPos; QPoint dragOff; bool dragging = false;
    Glass(const QString& id_, QSize sz, QPoint dp) : id(id_), defPos(dp) {
        setWindowFlags(Qt::FramelessWindowHint | Qt::Tool | Qt::WindowStaysOnBottomHint);
        setAttribute(Qt::WA_TranslucentBackground);
        setAttribute(Qt::WA_MacAlwaysShowToolWindow);
        resize(sz);
        move(QSettings().value("pos/" + id, defPos).toPoint());
        QObject::connect(&bus(), &Bus::changed, this, [this] { restyle(); update(); });
        g_widgets << this;
    }
    void resetPos() { QSettings().remove("pos/" + id); move(defPos); }
    virtual QString css() { return {}; }
    virtual void restyle() {
        auto& c = cfg();
        QString ss = (QString("QLabel,QLineEdit,QListWidget,QToolButton{color:#e6fff6;font-family:'%1';}"
                               "QScrollBar:vertical{background:transparent;width:6px;margin:0;}"
                               "QScrollBar::handle:vertical{background:rgba(255,255,255,60);border-radius:3px;min-height:24px;}"
                               "QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0;}"
                               "QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical{background:transparent;}").arg(c.font) +
                       css());
        ss.replace("ACC2", c.accent2.name()).replace("ACC", c.accent.name());
        setStyleSheet(ss);
    }
protected:
    void paintEvent(QPaintEvent*) override {
        QPainter p(this); p.setRenderHint(QPainter::Antialiasing);
        int op = cfg().wop.value(id, 0); if (op <= 0) op = cfg().opacity;
        p.setBrush(QColor(18, 48, 46, op * 255 / 100));
        p.setPen(QColor(255, 255, 255, 25));
        p.drawRoundedRect(rect().adjusted(1, 1, -1, -1), cfg().radius, cfg().radius);
    }
    void mousePressEvent(QMouseEvent* e) override {
        if (e->button() == Qt::LeftButton && !cfg().locked) { dragging = true; dragOff = e->globalPosition().toPoint() - frameGeometry().topLeft(); }
    }
    void mouseMoveEvent(QMouseEvent* e) override {
        if (!dragging) return;
        QPoint t = e->globalPosition().toPoint() - dragOff;
        if (cfg().snap && cfg().grid > 1 && !(e->modifiers() & Qt::AltModifier)) {      // snap to grid (hold ALT to ignore)
            QScreen* sc = QGuiApplication::screenAt(e->globalPosition().toPoint());
            if (!sc) sc = QGuiApplication::primaryScreen();
            QPoint o = sc->availableGeometry().topLeft(); int g = cfg().grid;
            t.setX(o.x() + qRound((t.x() - o.x()) / double(g)) * g);
            t.setY(o.y() + qRound((t.y() - o.y()) / double(g)) * g);
        }
        move(t);
    }
    void mouseReleaseEvent(QMouseEvent*) override {
        if (dragging) { dragging = false; QSettings().setValue("pos/" + id, pos()); }
    }
    void contextMenuEvent(QContextMenuEvent* e) override {
        QMenu m;
        m.addAction("settings...", [] { openSettings(); });
        m.addAction(cfg().locked ? "unlock position" : "lock position", [] { cfg().locked = !cfg().locked; saveCfg(); emit bus().changed(); });
        m.addAction("snap to grid: " + QString(cfg().snap ? "on" : "off"), [] { cfg().snap = !cfg().snap; saveCfg(); emit bus().changed(); });
        m.addAction("reset position", [this] { resetPos(); });
        m.addAction("hide", [this] { hide(); QSettings().setValue("visible/" + id, false); });
        m.exec(e->globalPos());
    }
};

// ---------------------------------------------------------------- search box with smooth typing animation
//  - underline follows the width of what you type (animated), with a glowing dot at its tip
//  - a soft accent ring pulses on every keystroke
class SmoothEdit : public QLineEdit {
    Q_OBJECT
    qreal ul_ = 0, pulse_ = 0;
    QVariantAnimation ua, pa;
public:
    SmoothEdit() {
        ua.setDuration(260); ua.setEasingCurve(QEasingCurve::OutCubic);
        connect(&ua, &QVariantAnimation::valueChanged, this, [this](const QVariant& v) { ul_ = v.toReal(); update(); });
        pa.setDuration(420); pa.setEasingCurve(QEasingCurve::OutQuad); pa.setStartValue(1.0); pa.setEndValue(0.0);
        connect(&pa, &QVariantAnimation::valueChanged, this, [this](const QVariant& v) { pulse_ = v.toReal(); update(); });
        connect(this, &QLineEdit::textChanged, this, [this] { pa.stop(); pa.start(); retarget(); });
    }
    void retarget() {
        qreal maxW = qMax(30, width() - 28);
        qreal t = hasFocus() ? qBound<qreal>(30.0, fontMetrics().horizontalAdvance(text()) + 50.0, maxW) : 0.0;
        ua.stop(); ua.setStartValue(ul_); ua.setEndValue(t); ua.start();
    }
protected:
    void focusInEvent(QFocusEvent* e) override { QLineEdit::focusInEvent(e); retarget(); }
    void focusOutEvent(QFocusEvent* e) override { QLineEdit::focusOutEvent(e); retarget(); }
    void paintEvent(QPaintEvent* e) override {
        QLineEdit::paintEvent(e);
        QPainter p(this); p.setRenderHint(QPainter::Antialiasing);
        if (ul_ > 0.5) {
            QColor c = cfg().accent; c.setAlpha(int(200 + 55 * pulse_));
            p.setPen(Qt::NoPen); p.setBrush(c);
            p.drawRoundedRect(QRectF(14, height() - 5, ul_, 3), 1.5, 1.5);
            QColor g = cfg().accent; g.setAlpha(int(90 + 140 * pulse_));
            p.setBrush(g); p.drawEllipse(QPointF(14 + ul_, height() - 3.5), 2.5 + 2.5 * pulse_, 2.5 + 2.5 * pulse_);
        }
        if (pulse_ > 0.01) {
            QColor g = cfg().accent; g.setAlpha(int(130 * pulse_));
            p.setBrush(Qt::NoBrush); p.setPen(QPen(g, 2));
            p.drawRoundedRect(QRectF(rect()).adjusted(1, 1, -1, -1), 12, 12);
        }
    }
};

// ---------------------------------------------------------------- list with a pink pill that glides to the hovered / selected row
class PillList : public QListWidget {
    Q_OBJECT
    qreal py = 0, ph = 0; bool has = false; QVariantAnimation a;
public:
    PillList() {
        setMouseTracking(true); viewport()->setMouseTracking(true);
        a.setDuration(240); a.setEasingCurve(QEasingCurve::OutCubic);
        connect(&a, &QVariantAnimation::valueChanged, this, [this](const QVariant& v) { py = v.toReal(); viewport()->update(); });
    }
    void syncPill(bool animate) {
        auto it = currentItem(); if (!it) return;
        QRect r = visualItemRect(it); if (r.isEmpty()) return;
        qreal target = r.top() + verticalScrollBar()->value(); ph = r.height();
        if (!has || !animate) { has = true; a.stop(); py = target; }
        else if (qAbs(py - target) > 0.5) { a.stop(); a.setStartValue(py); a.setEndValue(target); a.start(); }
        viewport()->update();
    }
protected:
    void paintEvent(QPaintEvent* e) override {
        if (has && currentItem()) {
            QPainter p(viewport()); p.setRenderHint(QPainter::Antialiasing);
            p.setPen(Qt::NoPen); p.setBrush(cfg().accent);
            p.drawRoundedRect(QRectF(0, py - verticalScrollBar()->value(), viewport()->width(), ph), 12, 12);
        }
        QListWidget::paintEvent(e);
    }
    void mouseMoveEvent(QMouseEvent* e) override {
        auto it = itemAt(e->position().toPoint());
        if (it && it != currentItem() && (it->flags() & Qt::ItemIsEnabled)) setCurrentItem(it);
        QListWidget::mouseMoveEvent(e);
    }
};

// ---------------------------------------------------------------- launcher (your own list, max 11 apps)
//  - hover an app: the pink pill glides to it.  DOUBLE-click (or Enter) opens it.  Single click only selects.
//  - typing searches your list first, then EVERY installed app
//  - "+ add app" opens a picker with every installed app; click one to add it
//  - right-click an app: change icon / reset icon / remove from list
class Launcher : public Glass {
    Q_OBJECT
    enum Kind { KApp = 0, KAdd = 1, KBack = 2, KAll = 3, KBrowse = 4 };
    static constexpr int kMax = 11, kRow = 42;      // kMax = the most apps you can add to the launcher (11)
    SmoothEdit* q; PillList* l;
    QList<App> apps, lnkApps, storeApps, pins; bool adding = false;
    QProcess* sp = nullptr;
    QHash<QString, QIcon> cache;
    QFileSystemWatcher fw; QTimer rescanT;
    QVariantAnimation hA;
    bool isAppKind(int k) const { return k == KApp || k == KAll; }
public:
    Launcher() : Glass("launcher", {280, 530}, {40, 40}) {
        setFixedWidth(280);
        auto v = new QVBoxLayout(this); v->setContentsMargins(12, 12, 12, 12); v->setSpacing(8);
        q = new SmoothEdit; q->setPlaceholderText("Search..."); q->addAction(magnifier(), QLineEdit::LeadingPosition); q->installEventFilter(this);
        l = new PillList; l->setFrameShape(QFrame::NoFrame); l->setFocusPolicy(Qt::NoFocus); l->setIconSize({26, 26});
        l->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff); l->setVerticalScrollMode(QAbstractItemView::ScrollPerPixel);
        l->setContextMenuPolicy(Qt::CustomContextMenu);
        v->addWidget(q); v->addWidget(l);
        connect(q, &QLineEdit::textChanged, this, [this] { fill(); });
        connect(q, &QLineEdit::returnPressed, this, [this] { activate(l->currentItem()); });
        // single click only selects; add/back rows and the app picker still react to one click
        connect(l, &QListWidget::itemClicked, this, [this](QListWidgetItem* i) {
            int k = i->data(Qt::UserRole + 1).toInt();
            if (adding || k == KAdd || k == KBack) activate(i);
        });
        // launching an app needs a double click (or Enter in the search box)
        connect(l, &QListWidget::itemDoubleClicked, this, [this](QListWidgetItem* i) {
            if (!adding && isAppKind(i->data(Qt::UserRole + 1).toInt())) activate(i);
        });
        connect(l, &QListWidget::currentItemChanged, this, [this](QListWidgetItem* cur) {
            for (int i = 0; i < l->count(); ++i) {       // add/back rows are dim, dark when under the pill
                auto it = l->item(i);
                if (!isAppKind(it->data(Qt::UserRole + 1).toInt())) it->setForeground(it == cur ? QColor("#1a1a1a") : QColor(255, 255, 255, 150));
            }
            l->syncPill(true);
        });
        connect(l, &QListWidget::customContextMenuRequested, this, [this](const QPoint& pos) { menuAt(pos); });
        connect(&bus(), &Bus::changed, this, [this] { cache.clear(); fill(); });

        // smooth list resize while typing
        hA.setDuration(180); hA.setEasingCurve(QEasingCurve::OutCubic);
        connect(&hA, &QVariantAnimation::valueChanged, this, [this](const QVariant& v) {
            l->setFixedHeight(v.toInt()); layout()->activate(); adjustSize();
        });

        loadPins();
        // pick up newly installed / removed apps automatically
        for (auto& d : appRoots()) if (QDir(d).exists()) fw.addPath(d);
        rescanT.setSingleShot(true); rescanT.setInterval(3000);
        connect(&fw, &QFileSystemWatcher::directoryChanged, this, [this] { rescanT.start(); });
        connect(&rescanT, &QTimer::timeout, this, [this] { rescan(); });
        auto per = new QTimer(this); connect(per, &QTimer::timeout, this, [this] { rescan(); }); per->start(600000);
        restyle(); rescan();
    }

    // ---- saved list
    void loadPins() {
        pins.clear();
        for (auto v : QJsonDocument::fromJson(QSettings().value("pinned").toString().toUtf8()).array()) {
            auto o = v.toObject(); pins.push_back({o["n"].toString(), o["t"].toString(), o["i"].toString(), o["c"].toString(), o["o"].toString()});
        }
        while (pins.size() > kMax) pins.removeLast();      // hard limit: 11 apps in the list
    }
    // user = true when the change came from the person (add / remove / icon); the auto-seed passes false
    void savePins(bool user = true) {
        QJsonArray a;
        for (auto& p : pins) a.append(QJsonObject{{"n", p.name}, {"t", p.target}, {"i", p.icon}, {"c", p.custom}, {"o", p.orig}});
        QSettings().setValue("pinned", QString::fromUtf8(QJsonDocument(a).toJson(QJsonDocument::Compact)));
        if (user) QSettings().setValue("pinsEdited", true);
    }
    bool isPinned(const App& a) const { for (auto& p : pins) if (p.target == a.target) return true; return false; }
    void seedPins() {   // only while the list is empty and you never edited it: pin whatever common apps are installed
        const QStringList want{"visual studio code", "github", "postman", "spotify", "discord", "file explorer", "terminal",
                               "powershell", "chrome", "firefox", "edge", "steam", "photoshop", "notepad"};
        for (auto& w : want) {
            if (pins.size() >= kMax) break;
            for (auto& a : apps) if (a.name.contains(w, Qt::CaseInsensitive) && !isPinned(a)) { pins.push_back(a); break; }
        }
        if (!pins.isEmpty()) savePins(false);
    }
    void mergeApps() {
        apps = lnkApps; QSet<QString> have;
        for (auto& a : apps) have.insert(a.name.toLower());
        for (auto& st : storeApps) {
            QString k = st.name.toLower(); bool bad = have.contains(k);
            for (auto b : {"uninstall", "readme", "release notes", "documentation", "license"}) if (k.contains(b)) bad = true;
            if (!bad) { have.insert(k); apps.push_back(st); }
        }
        std::sort(apps.begin(), apps.end(), [](const App& a, const App& b) { return a.name.toLower() < b.name.toLower(); });
        if (pins.isEmpty() && !QSettings().value("pinsEdited", false).toBool()) seedPins();
        fill();
    }
    void rescan() {
        lnkApps = scanApps();
        mergeApps();
#ifdef Q_OS_WIN
        if (sp) return;
        sp = new QProcess(this);
        sp->setCreateProcessArgumentsModifier([](QProcess::CreateProcessArguments* a) { a->flags |= CREATE_NO_WINDOW; });
        connect(sp, &QProcess::errorOccurred, this, [this] { if (sp) { sp->deleteLater(); sp = nullptr; } });
        connect(sp, &QProcess::finished, this, [this] {
            if (!sp) return;
            auto doc = QJsonDocument::fromJson(sp->readAllStandardOutput());
            QJsonArray arr = doc.isArray() ? doc.array() : QJsonArray{doc.object()};
            storeApps.clear();
            for (auto v : arr) {
                auto o = v.toObject(); QString n = o["Name"].toString(), id = o["AppID"].toString();
                if (!n.isEmpty() && !id.isEmpty()) storeApps.push_back({n, "shell:AppsFolder\\" + id, "", "", ""});
            }
            sp->deleteLater(); sp = nullptr;
            mergeApps();
        });
        sp->start("powershell", {"-NoProfile", "-NonInteractive", "-Command",
                                 "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-StartApps | ConvertTo-Json -Compress"});
#endif
    }

    // ---- list
    QIcon iconFor(const App& a) {
        QString key = a.target + "|" + a.custom;
        if (!cache.contains(key)) cache[key] = appIcon(a, 26);
        return cache[key];
    }
    void fit() {
        int target = (adding ? kMax : qBound(1, int(l->count()), kMax)) * kRow + 4;
        if (!isVisible()) { l->setFixedHeight(target); layout()->activate(); adjustSize(); return; }
        hA.stop(); hA.setStartValue(l->height()); hA.setEndValue(target); hA.start();
    }
    void fill() {
        l->clear(); QString f = q->text().trimmed();
        auto item = [this](const QString& text, const QIcon& ic, int kind, int idx) {
            auto it = new QListWidgetItem(ic, text);
            it->setData(Qt::UserRole, idx); it->setData(Qt::UserRole + 1, kind); it->setSizeHint(QSize(0, kRow));
            if (!isAppKind(kind)) it->setForeground(QColor(255, 255, 255, 150));
            l->addItem(it);
        };
        if (adding) {
            item("back", symbolIcon("<"), KBack, 0);
            item("browse for app...", symbolIcon("+"), KBrowse, 0);
            for (int i = 0; i < apps.size(); ++i) {
                if (isPinned(apps[i]) || (!f.isEmpty() && !apps[i].name.contains(f, Qt::CaseInsensitive))) continue;
                item(apps[i].name.toLower(), iconFor(apps[i]), KApp, i);
            }
        } else {
            for (int i = 0; i < pins.size(); ++i)
                if (f.isEmpty() || pins[i].name.contains(f, Qt::CaseInsensitive)) item(pins[i].name.toLower(), iconFor(pins[i]), KApp, i);
            if (f.isEmpty() && pins.size() < kMax) item("add app", symbolIcon("+"), KAdd, 0);   // list full (11) -> no add row
            if (!f.isEmpty()) {          // also search every installed app, not just your list
                int n = 0;
                for (int i = 0; i < apps.size() && n < 40; ++i)
                    if (!isPinned(apps[i]) && apps[i].name.contains(f, Qt::CaseInsensitive)) { item(apps[i].name.toLower(), iconFor(apps[i]), KAll, i); ++n; }
            }
        }
        l->setCurrentRow(adding && l->count() > 2 ? 2 : 0);
        fit();
    }
    void setAdding(bool a) {
        adding = a; q->clear();
        q->setPlaceholderText(a ? "find an app to add..." : "Search...");
        fill(); q->setFocus();
    }
    void activate(QListWidgetItem* it) {
        if (!it) return;
        int idx = it->data(Qt::UserRole).toInt(), kind = it->data(Qt::UserRole + 1).toInt();
        if (kind == KAdd) { if (pins.size() < kMax) setAdding(true); return; }
        if (kind == KBack) { setAdding(false); return; }
        if (kind == KBrowse) { browseApp(); return; }
        if (adding) {
            if (idx >= 0 && idx < apps.size() && pins.size() < kMax) { pins.push_back(apps[idx]); savePins(); }
            setAdding(false); return;
        }
        if (kind == KAll) { if (idx >= 0 && idx < apps.size()) { launchApp(apps[idx]); q->clear(); } return; }
        if (idx >= 0 && idx < pins.size()) { launchApp(pins[idx]); q->clear(); }
    }

    // pick any .exe / shortcut / .app by hand and add it to the list (for apps the scan cannot find)
    void browseApp() {
#ifdef Q_OS_WIN
        const QString filter = "apps (*.exe *.lnk *.bat *.cmd)";
#else
        const QString filter = "apps (*)";
#endif
        QString f = QFileDialog::getOpenFileName(nullptr, "choose an app to add", QDir::homePath(), filter);
        if (f.isEmpty() || pins.size() >= kMax) return;
        QString n = QFileInfo(f).completeBaseName();
        if (n.compare("code", Qt::CaseInsensitive) == 0) n = "Visual Studio Code";
        App a{n, f, "", "", ""};
        if (!isPinned(a)) { pins.push_back(a); savePins(); }
        setAdding(false);
    }

    // ---- right click on an app
    void menuAt(const QPoint& pos) {
        auto it = l->itemAt(pos);
        if (!it || adding) return;
        int kind = it->data(Qt::UserRole + 1).toInt(), i = it->data(Qt::UserRole).toInt();
        QMenu m;
        if (kind == KAll) {
            if (i < 0 || i >= apps.size()) return;
            if (pins.size() < kMax) m.addAction("add to my list", [this, i] { pins.push_back(apps[i]); savePins(); q->clear(); fill(); });
        } else if (kind == KApp) {
            if (i < 0 || i >= pins.size()) return;
            m.addAction("rename...", [this, i] { renamePin(i); });
            if (!pins[i].orig.isEmpty() && pins[i].orig != pins[i].name)
                m.addAction("reset name", [this, i] { pins[i].name = pins[i].orig; pins[i].orig.clear(); savePins(); fill(); });
            m.addAction("change icon...", [this, i] { pickIcon(i); });
            if (!pins[i].custom.isEmpty()) m.addAction("reset icon", [this, i] { pins[i].custom.clear(); savePins(); cache.clear(); fill(); });
            m.addSeparator();
            m.addAction("remove from list", [this, i] { pins.removeAt(i); savePins(); fill(); });
        } else return;
        m.exec(l->viewport()->mapToGlobal(pos));
    }
    // the new name is only used inside this launcher: the real app and its shortcut are not touched
    void renamePin(int i) {
        bool ok = false;
        QString n = QInputDialog::getText(nullptr, "rename", "name shown in the launcher (the real app is not changed):",
                                          QLineEdit::Normal, pins[i].name, &ok).trimmed();
        if (!ok || n.isEmpty() || n == pins[i].name) return;
        if (pins[i].orig.isEmpty()) pins[i].orig = pins[i].name;
        pins[i].name = n; savePins(); fill();
    }
    void pickIcon(int i) {
        QString f = QFileDialog::getOpenFileName(nullptr, "choose icon for " + pins[i].name, QDir::homePath(),
                                                 "images (*.png *.ico *.jpg *.jpeg *.bmp *.webp *.svg)");
        if (f.isEmpty()) return;
        if (QPixmap(f).isNull()) { QMessageBox::warning(nullptr, "BetterWidgets", "could not read that image. try a .png or .ico file."); return; }
        QString dir = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/icons"; QDir().mkpath(dir);
        QString dst = dir + "/" + QString::fromLatin1(QCryptographicHash::hash(pins[i].target.toUtf8(), QCryptographicHash::Md5).toHex())
                      + "." + QFileInfo(f).suffix();
        if (f != dst) { QFile::remove(dst); if (!QFile::copy(f, dst)) dst = f; }
        pins[i].custom = dst; savePins(); cache.clear(); fill();
    }

    bool eventFilter(QObject* o, QEvent* e) override {
        if (o == q && e->type() == QEvent::KeyPress) {
            int k = static_cast<QKeyEvent*>(e)->key();
            if (k == Qt::Key_Down || k == Qt::Key_Up) {
                l->setCurrentRow(qBound(0, l->currentRow() + (k == Qt::Key_Down ? 1 : -1), qMax(0, int(l->count()) - 1))); return true;
            }
            if (k == Qt::Key_Escape) { if (adding) setAdding(false); else q->clear(); return true; }
        }
        return Glass::eventFilter(o, e);
    }
    void showEvent(QShowEvent* e) override {
        Glass::showEvent(e);
        QTimer::singleShot(0, this, [this] { l->syncPill(false); });
    }
    QString css() override {
        return "QLineEdit{background:#f4f4ee;color:#222;border-radius:12px;padding:6px 10px;}"
               "QListWidget{background:transparent;outline:0;font-size:14px;font-weight:600;}"
               "QListWidget::item{padding:0 8px;border-radius:12px;background:transparent;}"
               "QListWidget::item:hover{background:transparent;}"
               "QListWidget::item:selected{background:transparent;color:#1a1a1a;}";
    }
};

// ---------------------------------------------------------------- clock (always english day / month names)
class Clock : public Glass {
    Q_OBJECT
    QLabel *t, *s, *d;
public:
    Clock() : Glass("clock", {260, 140}, {340, 78}) {
        auto v = new QVBoxLayout(this); auto h = new QHBoxLayout;
        v->setContentsMargins(0, 20, 0, 4);   // pushes both the time and the date down (raise the 20 to push further)
        t = new QLabel; t->setObjectName("big"); s = new QLabel; s->setObjectName("sec"); d = new QLabel; d->setAlignment(Qt::AlignCenter);
        h->addStretch(); h->addWidget(t); h->addWidget(s, 0, Qt::AlignBottom); h->addStretch();
        v->addLayout(h); v->addWidget(d);
        auto tm = new QTimer(this); connect(tm, &QTimer::timeout, this, [this] { tick(); }); tm->start(1000);
        restyle(); tick();
    }
    void tick() {
        const QLocale en(QLocale::English, QLocale::UnitedStates);
        auto n = QDateTime::currentDateTime();
        t->setText(en.toString(n, cfg().h24 ? "HH:mm" : "h:mm"));
        s->setText(cfg().secs ? en.toString(n, cfg().h24 ? "ss" : "ss ap") : ""); s->setVisible(cfg().secs);
        d->setText(en.toString(n.date(), "dddd, MMMM d"));
    }
    void restyle() override { Glass::restyle(); tick(); }
    QString css() override { return "#big{font-size:50px;font-weight:700;} #sec{font-size:18px;color:ACC2;margin-bottom:8px;}"; }
};

// ---------------------------------------------------------------- system card (profile picture + specs)
static QString osLine() {
#ifdef Q_OS_MAC
    return "macos " + QSysInfo::productVersion() + " (" + sh("sw_vers", {"-buildVersion"}) + ")";
#else
    return QSysInfo::prettyProductName().toLower();
#endif
}
static QString shellLine() {
#ifdef Q_OS_WIN
    return "powershell";
#else
    QString p = qEnvironmentVariable("SHELL"); if (p.isEmpty()) return "-";
    auto m = QRegularExpression("\\d+(\\.\\d+)+").match(sh(p, {"--version"}));
    return QFileInfo(p).fileName() + (m.hasMatch() ? " " + m.captured() : "");
#endif
}
static QString cpuName() {
#ifdef Q_OS_MAC
    return sh("sysctl", {"-n", "machdep.cpu.brand_string"});
#elif defined(Q_OS_WIN)
    return QSettings("HKEY_LOCAL_MACHINE\\HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0", QSettings::NativeFormat)
        .value("ProcessorNameString", "unknown").toString().trimmed();
#else
    QFile f("/proc/cpuinfo");
    if (f.open(QIODevice::ReadOnly))
        for (auto& ln : f.readAll().split('\n'))
            if (ln.startsWith("model name")) return QString::fromUtf8(ln.mid(ln.indexOf(':') + 1)).trimmed();
    return QSysInfo::currentCpuArchitecture();
#endif
}

// "11th Gen Intel(R) Core(TM) i9-11900 @ 2.50GHz" -> "Intel Core i9-11900"
static QString tidyCpu(QString s) {
    s.remove("(R)").remove("(TM)").remove("(r)").remove("(tm)");
    s.remove(QRegularExpression("\\s+CPU\\b"));
    s.remove(QRegularExpression("\\s*@.*$"));
    s.remove(QRegularExpression("^\\d+(st|nd|rd|th) Gen\\s+"));
    return s.simplified();
}

// layout: big square picture on the left; next to it the "admin: name" line, a gap, then three spec lines (all vertically
// centred on the picture); the storage + cpu lines sit at the very bottom of the card, spanning the full width
class SysInfo : public Glass {
    Q_OBJECT
    QToolButton* av; QLabel *name, *info, *low; QString user;
    static constexpr int kAv = 124, kGapLow = 15, kW = 370;   // bigger picture, 15px gap above the bottom lines, wider card (set kW = 340 for the old width)
public:
    SysInfo() : Glass("sysinfo", {kW, 184}, {620, 40}) {
        user = qEnvironmentVariable("USER", qEnvironmentVariable("USERNAME", "user"));
        auto v = new QVBoxLayout(this); v->setContentsMargins(14, 12, 14, 12); v->setSpacing(0);
        auto top = new QHBoxLayout; top->setSpacing(14);
        av = new QToolButton; av->setObjectName("avatar"); av->setFixedSize(kAv, kAv); av->setIconSize({kAv, kAv});
        av->setCursor(Qt::PointingHandCursor); av->setToolTip("click to change picture");
        name = new QLabel(this); name->setObjectName("name");     // name + info are placed by hand in placeText()
        info = new QLabel(this); info->setObjectName("info");
        low = new QLabel; low->setObjectName("low");
        // the card keeps a fixed compact size: long lines wrap instead of stretching the widget
        for (auto* lb : {name, info, low}) { lb->setWordWrap(true); lb->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Preferred); }
        setFixedWidth(kW);                     // the height is worked out in restyle() from the picture + text sizes
        top->addWidget(av, 0, Qt::AlignTop); top->addStretch(1);   // picture on the left; the text is positioned in placeText()
        v->addLayout(top);
        v->addSpacing(kGapLow);                // exactly 15px between the picture block and the two bottom lines
        v->addWidget(low);
        connect(av, &QToolButton::clicked, this, [this] {
            QString f = QFileDialog::getOpenFileName(nullptr, "choose picture", QDir::homePath(), "images (*.png *.jpg *.jpeg *.webp *.bmp)");
            if (!f.isEmpty()) { cfg().avatar = f; saveCfg(); setAvatar(); }
        });
        auto tm = new QTimer(this); connect(tm, &QTimer::timeout, this, [this] { update_(); }); tm->start(30000);
        restyle();
    }
    void setAvatar() {
        QPixmap px; if (!cfg().avatar.isEmpty()) px.load(cfg().avatar);
        av->setIcon(QIcon(px.isNull() ? letterTile(user, kAv, 22) : roundedSq(px, kAv, 22)));
    }
    void update_() {
        static const QString os = osLine(), shell = shellLine(), cpu = tidyCpu(cpuName());
        const double G = 1073741824.0; QStorageInfo st = QStorageInfo::root();
        double tot = st.bytesTotal() / G, fr = st.bytesAvailable() / G;
        name->setText("admin: " + user);
        info->setText(QString("%1<br>%2 GB &bull; %3<br>shell %4")
            .arg(os, QString::number(ramGB(), 'f', 0), QSysInfo::currentCpuArchitecture(), shell));
        low->setText(QString("%1Gi total / %2Gi used / %3Gi free<br>cpu %4 (%5 cores)")
            .arg(tot, 0, 'f', 0).arg(tot - fr, 0, 'f', 0).arg(fr, 0, 'f', 0).arg(cpu).arg(QThread::idealThreadCount()));
    }
    void restyle() override {
        Glass::restyle(); setAvatar();
        QFont lf(cfg().font); lf.setPixelSize(12); lf.setWeight(QFont::DemiBold);
        int lowH = 2 * QFontMetrics(lf).lineSpacing() + 2;       // two bottom lines
        low->setFixedHeight(lowH);
        setFixedSize(kW, 12 + kAv + kGapLow + lowH + 12);
        update_(); placeText();
    }
    // the 3 spec lines are centred on the card's own middle (vertically); the admin line sits 15px above them
    void placeText() {
        QFont nf(cfg().font); nf.setPixelSize(15); nf.setWeight(QFont::Bold);
        QFont inf(cfg().font); inf.setPixelSize(12); inf.setWeight(QFont::DemiBold);
        const int x = 14 + kAv + 14, w = kW - x - 14;
        const int nameH = QFontMetrics(nf).lineSpacing() + 2, infoH = 3 * QFontMetrics(inf).lineSpacing() + 2;
        const int infoY = height() / 2 - infoH / 2, nameY = infoY - 15 - nameH;
        info->setGeometry(x, infoY, w, infoH);
        name->setGeometry(x, nameY, w, nameH);
    }
    QString css() override {
        return "#name{font-size:15px;font-weight:700;color:ACC2;} #info{font-size:12px;font-weight:600;} "
               "#low{font-size:12px;font-weight:600;} #avatar{border:none;background:transparent;}";
    }
};

// ---------------------------------------------------------------- github activity (compact, reference-style)
class Github : public Glass {
    Q_OBJECT
    QNetworkAccessManager nam; QMap<QDate, int> lv; QString msg = "set your github username in settings"; QTimer tm; QString lastUser;
public:
    Github() : Glass("github", {560, 224}, {340, 232}) {
        connect(&tm, &QTimer::timeout, this, [this] { fetch(); });
        connect(&bus(), &Bus::changed, this, [this] {
            if (cfg().user != lastUser) fetch(); else tm.start(qMax(5, cfg().refresh) * 60000);
        });
        restyle(); fetch();
    }
    void fetch() {
        lastUser = cfg().user;
        tm.start(qMax(5, cfg().refresh) * 60000);
        if (cfg().user.isEmpty()) { msg = "set your github username in settings"; update(); return; }
        msg = "loading..."; update();
        QNetworkRequest r(QUrl("https://github.com/users/" + cfg().user + "/contributions"));
        r.setHeader(QNetworkRequest::UserAgentHeader, "BetterWidgets");
        r.setRawHeader("Accept-Language", "en-US,en;q=0.9");
        auto rep = nam.get(r);
        connect(rep, &QNetworkReply::finished, this, [this, rep] {
            rep->deleteLater();
            if (rep->error()) { msg = "could not reach github"; update(); return; }
            parse(QString::fromUtf8(rep->readAll()));
        });
    }
    void parse(const QString& h) {
        lv.clear();
        QRegularExpression tag("<td[^>]*>"), d("data-date=\"(\\d{4}-\\d\\d-\\d\\d)\""), l("data-level=\"(\\d)\"");
        auto it = tag.globalMatch(h);
        while (it.hasNext()) {
            auto t = it.next().captured(); auto a = d.match(t), b = l.match(t);
            if (a.hasMatch() && b.hasMatch()) lv[QDate::fromString(a.captured(1), Qt::ISODate)] = b.captured(1).toInt();
        }
        msg = lv.isEmpty() ? "no data found" : ""; update();
    }
    static QColor lc(int l) { if (!l) return QColor(255, 255, 255, 28); QColor c = cfg().accent2; c.setAlpha(qMin(255, 55 + l * 50)); return c; }
    static QColor ringColor(int l) { return l == 0 ? QColor(255, 255, 255, 70) : lc(l); }
protected:
    void mouseDoubleClickEvent(QMouseEvent*) override { openSettings(); }
    void paintEvent(QPaintEvent* e) override {
        Glass::paintEvent(e);
        QPainter p(this); p.setRenderHint(QPainter::Antialiasing);
        const int W = width(), H = height();      // 560x224, drawn 1:1
        const int right = W - 20;                  // right edge shared by the badge, the ring column and the legend
        // title (smaller) + badge
        QFont f(cfg().font); f.setPointSize(10); f.setWeight(QFont::DemiBold); p.setFont(f); p.setPen(QColor("#e6fff6"));
        p.drawText(24, 32, "github activity");
        QRect badge(right - 100, 12, 100, 22);
        p.setBrush(cfg().accent); p.setPen(Qt::NoPen); p.drawRoundedRect(badge, 9, 9);
        f.setPointSize(8); p.setFont(f); p.setPen(QColor("#1a1a1a")); p.drawText(badge, Qt::AlignCenter, "last 3 months");
        p.setPen(QColor("#e6fff6"));
        if (!msg.isEmpty()) { f.setWeight(QFont::Normal); f.setPointSize(11); p.setFont(f); p.drawText(QRect(0, 0, W, H).adjusted(20, 44, -20, -14), Qt::AlignCenter, msg); return; }

        // heatmap: 17 weeks. wider horizontal gap (hp) than vertical gap (vp)
        constexpr int hp = 22, vp = 17, cell = 12, gx = 24, gy = 64, weeks = 17;
        static const char* mon[] = {"jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"};
        f.setWeight(QFont::Medium); f.setPointSize(8); p.setFont(f);
        QDate today = QDate::currentDate(), start = today.addDays(-(weeks - 1) * 7);
        start = start.addDays(-(start.dayOfWeek() % 7));
        int total = 0, cnt[5] = {0, 0, 0, 0, 0};
        for (QDate d = start; d <= today; d = d.addDays(1)) {
            int col = start.daysTo(d) / 7, row = d.dayOfWeek() % 7, x = gx + col * hp, y = gy + row * vp;
            int level = qBound(0, lv.value(d, 0), 4); total++; cnt[level]++;
            p.setPen(Qt::NoPen); p.setBrush(lc(level)); p.drawRoundedRect(x, y, cell, cell, 3, 3);
            if (row == 0 && d.day() <= 7) { p.setPen(QColor("#bfe")); p.drawText(x, gy - 8, QString(mon[d.month() - 1])); }
        }

        // ring: a full grey track that is never cut, with the colour pills sitting INSIDE it (pills are 4px thinner than the track).
        // only the levels that really exist get a pill (2 colours = 2 pills). each pill is exactly as long as its share of all days
        // (grey = the empty days counts too). the smallest a pill can get is a round dot, so a 5% share still shows as a dot
        const double r = 54, pw = 10, track = pw + 4, outerR = r + track / 2;
        const double lw = outerR * 2 * 1.1;                      // legend is 10% longer than the ring
        const double cx = right - lw / 2;                        // ring is centred over the legend / badge column
        const double cy = gy + (6 * vp + cell) / 2.0;            // exact vertical centre of the calendar grid
        QPointF c(cx, cy);
        QRectF rr(cx - r, cy - r, 2 * r, 2 * r);
        p.setBrush(Qt::NoBrush);
        p.setPen(QPen(QColor(255, 255, 255, 40), track)); p.drawEllipse(c, r, r);
        const double capDeg = (pw / 2) / r * 57.29578;           // how far a round cap sticks out, in degrees
        int used = 0; for (int i = 0; i < 5; ++i) if (cnt[i]) ++used;
        // every pill gets an exact slice of the circle. a slice is never smaller than one round dot (cap to cap + a hair of gap),
        // and the slices of the bigger pills shrink to pay for that, so the pills can never run into each other
        const double gapDeg = 1.0, minLen = 2 * capDeg + gapDeg + 0.5;
        double L[5] = {0, 0, 0, 0, 0}; bool fix[5] = {false, false, false, false, false};
        for (int i = 0; i < 5; ++i) if (cnt[i] && total) L[i] = 360.0 * cnt[i] / total;
        for (int pass = 0; pass < 6; ++pass) {
            double budget = 360, freeCnt = 0;
            for (int i = 0; i < 5; ++i) if (cnt[i]) { if (fix[i]) budget -= minLen; else freeCnt += cnt[i]; }
            bool changed = false;
            for (int i = 0; i < 5; ++i) if (cnt[i] && !fix[i] && freeCnt > 0) {
                L[i] = budget * cnt[i] / freeCnt;
                if (L[i] < minLen) { fix[i] = true; changed = true; }
            }
            if (!changed) break;
        }
        for (int i = 0; i < 5; ++i) if (fix[i]) L[i] = minLen;
        double startDeg = 90;                                    // 12 o'clock, going clockwise
        for (int i = 4; i >= 0 && total; --i) {
            if (!cnt[i]) continue;                               // no empty slots: levels with no days get no pill
            p.setPen(QPen(ringColor(i), pw, Qt::SolidLine, Qt::RoundCap));
            if (used == 1) p.drawEllipse(c, r, r);               // a single level fills the whole circle
            else {
                double mid = startDeg - L[i] / 2;                // centre of this pill's slice
                double s = qMax(0.1, L[i] - gapDeg - 2 * capDeg);   // arc length without the caps (0.1 = a round dot)
                p.drawArc(rr, int((mid + s / 2) * 16), int(-s * 16));   // same radius as the track, so every pill hugs the circle
            }
            startDeg -= L[i];
        }

        // legend: 10% longer than the ring, right edge lines up with the "last 3 months" badge
        f.setPointSize(7); f.setWeight(QFont::Medium); p.setFont(f);
        const QFontMetrics fm = p.fontMetrics();
        const int lessW = fm.horizontalAdvance("less"), moreW = fm.horizontalAdvance("more"), sq = 10, padX = 9, gap = 6, bh = 20;
        const int bw = int(lw + 0.5), bx = right - bw, by = int(cy + outerR) + 10;
        const double step = (bw - 2 * padX - lessW - moreW - 2 * gap - sq) / 4.0;
        p.setBrush(QColor(255, 255, 255, 22)); p.setPen(QColor(255, 255, 255, 45)); p.drawRoundedRect(bx, by, bw, bh, 8, 8);
        p.setPen(QColor("#e6fff6"));
        p.drawText(QRect(bx + padX, by, lessW, bh), Qt::AlignVCenter | Qt::AlignLeft, "less");
        p.drawText(QRect(bx + bw - padX - moreW, by, moreW, bh), Qt::AlignVCenter | Qt::AlignRight, "more");
        const double lx = bx + padX + lessW + gap;
        for (int i = 0; i < 5; ++i) { p.setPen(Qt::NoPen); p.setBrush(lc(i)); p.drawRoundedRect(QRectF(lx + i * step, by + (bh - sq) / 2.0, sq, sq), 2, 2); }
    }
};

// ---------------------------------------------------------------- anime: catalog + covers
struct Show { int id = 0; QString t, cover, url; int ep = 0, total = 0; bool airing = false; };   // total 0 = unknown

// Crunchyroll has no public API, so the catalog comes from AniList (public, no key): every anime AniList lists as
// licensed by Crunchyroll (airing + finished), fetched page by page in the background and cached on disk.
// If that filter ever fails, it falls back to "currently airing anime that have a Crunchyroll link".
class Catalog : public QObject {
    Q_OBJECT
    QNetworkAccessManager nam; QList<Show> list, acc; QTimer tm; QDateTime last; bool busy_ = false, fallback = false;
public:
    static Catalog& get() { static Catalog c; return c; }
    const QList<Show>& items() const { return list; }
    bool busy() const { return busy_; }
    int loaded() const { return acc.size(); }
    void refreshIfStale() { if (!last.isValid() || last.secsTo(QDateTime::currentDateTime()) > 3600) fetch(); }
    void fetch() { if (busy_) return; busy_ = true; fallback = false; acc.clear(); page(1); }
signals: void updated();
private:
    static QString cachePath() {
        QString dir = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation); QDir().mkpath(dir);
        return dir + "/crunchyroll.json";
    }
    Catalog() {
        QFile f(cachePath());
        if (f.open(QIODevice::ReadOnly)) {
            for (auto v : QJsonDocument::fromJson(f.readAll()).array()) {
                auto o = v.toObject();
                list.push_back({o["id"].toInt(), o["t"].toString(), o["c"].toString(), o["u"].toString(), 0, o["n"].toInt(), o["a"].toBool()});
            }
            last = QFileInfo(cachePath()).lastModified();
        }
        connect(&tm, &QTimer::timeout, this, [this] { fetch(); }); tm.start(6 * 3600 * 1000);
        fetch();
    }
    void finish() {
        if (!acc.isEmpty()) {
            list = acc; last = QDateTime::currentDateTime();
            std::stable_sort(list.begin(), list.end(), [](const Show& a, const Show& b) { return a.airing && !b.airing; });   // airing first
            QJsonArray a;
            for (auto& s : list) a.append(QJsonObject{{"id", s.id}, {"t", s.t}, {"c", s.cover}, {"u", s.url}, {"n", s.total}, {"a", s.airing}});
            QFile f(cachePath()); if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) f.write(QJsonDocument(a).toJson(QJsonDocument::Compact));
        }
        busy_ = false; emit updated();
    }
    void page(int n) {
        static const QString qAll = R"gql(query($page:Int){Page(page:$page,perPage:50){pageInfo{hasNextPage}
            media(type:ANIME,isAdult:false,licensedBy:"Crunchyroll",sort:POPULARITY_DESC){id status title{romaji english}episodes
            coverImage{medium}externalLinks{site url}}}})gql";
        static const QString qAir = R"gql(query($page:Int){Page(page:$page,perPage:50){pageInfo{hasNextPage}
            media(type:ANIME,status:RELEASING,isAdult:false,sort:POPULARITY_DESC){id status title{romaji english}episodes
            coverImage{medium}externalLinks{site url}}}})gql";
        QJsonObject body{{"query", fallback ? qAir : qAll}, {"variables", QJsonObject{{"page", n}}}};
        QNetworkRequest r{QUrl("https://graphql.anilist.co")};
        r.setHeader(QNetworkRequest::ContentTypeHeader, "application/json"); r.setRawHeader("Accept", "application/json");
        auto rep = nam.post(r, QJsonDocument(body).toJson(QJsonDocument::Compact));
        connect(rep, &QNetworkReply::finished, this, [this, rep, n] {
            rep->deleteLater();
            int code = rep->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
            if (code == 429) { QTimer::singleShot(61000, this, [this, n] { page(n); }); return; }   // rate limited: wait a minute, continue
            auto doc = QJsonDocument::fromJson(rep->readAll()).object();
            if ((rep->error() || doc.contains("errors")) && n == 1 && !fallback) { fallback = true; page(1); return; }
            if (rep->error()) { finish(); return; }
            auto pg = doc["data"].toObject()["Page"].toObject();
            for (auto v : pg["media"].toArray()) {
                auto m = v.toObject(); QString url;
                for (auto e : m["externalLinks"].toArray())
                    if (e.toObject()["site"].toString() == "Crunchyroll") url = e.toObject()["url"].toString();
                auto t = m["title"].toObject();
                QString name = t["english"].isString() ? t["english"].toString() : t["romaji"].toString();
                if (url.isEmpty()) { if (fallback) continue; url = "https://www.crunchyroll.com/search?q=" + QString::fromUtf8(QUrl::toPercentEncoding(name)); }
                acc.push_back({m["id"].toInt(), name, m["coverImage"].toObject()["medium"].toString(), url, 0, m["episodes"].toInt(),
                               m["status"].toString() == "RELEASING"});
            }
            bool more = pg["pageInfo"].toObject()["hasNextPage"].toBool() && n < 70;
            if (!more) { finish(); return; }
            if (n == 1 || n % 6 == 0) { if (list.isEmpty()) list = acc; emit updated(); }    // show something early while the rest loads
            QTimer::singleShot(400, this, [this, n] { page(n + 1); });
        });
    }
};

// poster icon: disk-cached, downloaded once
static void fetchCover(int id, const QString& url, QObject* ctx, std::function<void(QPixmap)> cb) {
    QString dir = QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + "/covers";
    QDir().mkpath(dir); QString path = QString("%1/%2.jpg").arg(dir).arg(id);
    QPixmap px;
    if (QFile::exists(path) && px.load(path)) { cb(roundedSq(px, 40, 10)); return; }
    if (url.isEmpty()) return;
    static QNetworkAccessManager nam;
    QNetworkRequest r{QUrl(url)}; r.setHeader(QNetworkRequest::UserAgentHeader, "BetterWidgets");
    auto rep = nam.get(r);
    QObject::connect(rep, &QNetworkReply::finished, rep, &QObject::deleteLater);
    QObject::connect(rep, &QNetworkReply::finished, ctx, [=] {
        if (rep->error()) return;
        QByteArray d = rep->readAll(); QPixmap p; if (!p.loadFromData(d)) return;
        QFile f(path); if (f.open(QIODevice::WriteOnly)) f.write(d);
        cb(roundedSq(p, 40, 10));
    });
}

// thick dashed rectangle with a plus in the middle; hosts the expandable crunchyroll list
class DashedBox : public QWidget {
    Q_OBJECT
    bool hover = false;
public:
    bool open = false;
    DashedBox() { setMinimumHeight(56); setCursor(Qt::PointingHandCursor); }
signals: void clicked();
protected:
    void enterEvent(QEnterEvent*) override { hover = true; update(); }
    void leaveEvent(QEvent*) override { hover = false; update(); }
    void mousePressEvent(QMouseEvent* e) override {
        if (!open && e->button() == Qt::LeftButton) emit clicked(); else QWidget::mousePressEvent(e);
    }

            QPointF m = QRectF(rect()).center(); p.setPen(QPen(c, 3, Qt::SolidLine, Qt::RoundCap));
            p.drawLine(m + QPointF(-9, 0), m + QPointF(9, 0)); p.drawLine(m + QPointF(0, -9), m + QPointF(0, 9));
        }
    }

// label that never forces its parent wider: text longer than the space it gets is cut with "..."
class ElideLabel : public QLabel {
    QString full;
public:
    explicit ElideLabel(const QString& t) : full(t) {
        setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Preferred); setMinimumWidth(0); setToolTip(t); QLabel::setText(t);
    }
    QSize sizeHint() const override { return {0, QLabel::sizeHint().height()}; }
    QSize minimumSizeHint() const override { return {0, QLabel::minimumSizeHint().height()}; }
protected:
    void resizeEvent(QResizeEvent* e) override { QLabel::resizeEvent(e); reelide(); }
    void changeEvent(QEvent* e) override {
        QLabel::changeEvent(e);
        if (e->type() == QEvent::FontChange || e->type() == QEvent::StyleChange) reelide();
    }
private:
    void reelide() {
        QString s = fontMetrics().elidedText(full, Qt::ElideRight, qMax(0, width()));
        if (s != text()) QLabel::setText(s);
    }
};

// ---------------------------------------------------------------- currently watching (max 2 shows)
//  - the dashed "+" box disappears while 2 shows are on the list, and comes back when you remove one
//  - a newly added show pops in with a bouncy grow + fade animation
class Watching : public Glass {
    Q_OBJECT
    static constexpr int kMaxShows = 2, kRowH = 64, kGap = 6;
    QVBoxLayout* rows; QScrollArea* sc; QList<Show> shows;
    DashedBox* box; QWidget* panel; QLineEdit* flt; QListWidget* cat;
    QHash<int, QPixmap> covers; QSet<int> pending; QHash<QChar, QPixmap> tiles;
public:
    Watching() : Glass("watching", {380, 100}, {580, 480}) {
        for (auto v : QJsonDocument::fromJson(QSettings().value("shows").toString().toUtf8()).array()) {
            auto o = v.toObject();
            if (shows.size() >= kMaxShows) break;
            shows.push_back({o["id"].toInt(), o["t"].toString(), o["cover"].toString(), o["url"].toString(), o["ep"].toInt(), o["total"].toInt()});
        }
        setFixedWidth(380);
        auto v = new QVBoxLayout(this); v->setContentsMargins(12, 10, 12, 12); v->setSpacing(8);
        v->addWidget(new QLabel("currently watching"));
        sc = new QScrollArea; sc->setFrameShape(QFrame::NoFrame); sc->setWidgetResizable(true);
        sc->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff); sc->setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
        sc->viewport()->setAutoFillBackground(false);
        auto host = new QWidget; host->setObjectName("host");
        rows = new QVBoxLayout(host); rows->setContentsMargins(0, 0, 0, 0); rows->setSpacing(kGap);
        sc->setWidget(host); v->addWidget(sc);

        box = new DashedBox; v->addWidget(box);
        auto bl = new QVBoxLayout(box); bl->setContentsMargins(10, 10, 10, 10);
        panel = new QWidget; panel->hide(); bl->addWidget(panel);
        auto pv = new QVBoxLayout(panel); pv->setContentsMargins(0, 0, 0, 0); pv->setSpacing(8);
        auto top = new QHBoxLayout; flt = new QLineEdit; flt->setPlaceholderText("search crunchyroll...");
        auto close = new QToolButton; close->setText("\u00d7"); close->setObjectName("close");
        top->addWidget(flt, 1); top->addWidget(close); pv->addLayout(top);
        cat = new QListWidget; cat->setFrameShape(QFrame::NoFrame); cat->setFocusPolicy(Qt::NoFocus); cat->setIconSize({40, 40});
        cat->setMinimumHeight(380); cat->setVerticalScrollMode(QAbstractItemView::ScrollPerPixel); cat->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
        pv->addWidget(cat);

        connect(box, &DashedBox::clicked, this, [this] { setOpen(true); });
        connect(close, &QToolButton::clicked, this, [this] { setOpen(false); });
        connect(flt, &QLineEdit::textChanged, this, [this] { fillCatalog(); });
        connect(cat, &QListWidget::itemClicked, this, [this](QListWidgetItem* it) { add(it->data(Qt::UserRole).toInt()); });
        connect(cat->verticalScrollBar(), &QScrollBar::valueChanged, this, [this] { loadVisible(); });
        connect(&Catalog::get(), &Catalog::updated, this, [this] { fillCatalog(); });
        restyle(); rebuild();
    }
    // restyle runs on every settings change: re-apply the 2-show rule so the dashed box can never reappear at the limit
    void restyle() override { Glass::restyle(); tiles.clear(); box->setVisible(shows.size() < kMaxShows); box->update(); }

    QPixmap tileFor(const QString& t) {
        QChar k = t.isEmpty() ? QChar('?') : t[0].toUpper();
        if (!tiles.contains(k)) tiles[k] = letterTile(QString(k), 40, 10);
        return tiles[k];
    }
    void requestCover(int id, const QString& url) {
        if (!id || covers.contains(id) || pending.contains(id)) return;
        pending.insert(id);
        fetchCover(id, url, this, [this, id](QPixmap p) { gotCover(id, p); });
    }
    QPixmap coverFor(const Show& s) { requestCover(s.id, s.cover); return covers.contains(s.id) ? covers[s.id] : tileFor(s.t); }
    void gotCover(int id, const QPixmap& p) {
        covers[id] = p;
        for (auto* lb : findChildren<QLabel*>(QString("cv%1").arg(id))) lb->setPixmap(p);
        for (int i = 0; i < cat->count(); ++i) if (cat->item(i)->data(Qt::UserRole).toInt() == id) { cat->item(i)->setIcon(QIcon(p)); break; }
    }
    // only download posters for the rows you can actually see (the catalog has ~1000+ shows)
    void loadVisible() {
        if (!box->open) return;
        int r0 = qMax(0, cat->indexAt(QPoint(8, 8)).row());
        for (int i = r0; i < qMin(cat->count(), r0 + 12); ++i) {
            int id = cat->item(i)->data(Qt::UserRole).toInt();
            if (id) requestCover(id, cat->item(i)->data(Qt::UserRole + 1).toString());
        }
    }
    void save() {
        QJsonArray a;
        for (auto& s : shows) a.append(QJsonObject{{"id", s.id}, {"t", s.t}, {"cover", s.cover}, {"url", s.url}, {"ep", s.ep}, {"total", s.total}});
        QSettings().setValue("shows", QString::fromUtf8(QJsonDocument(a).toJson(QJsonDocument::Compact)));
    }
    bool watching(int id) const { for (auto& s : shows) if (s.id == id) return true; return false; }
    void refit() { layout()->activate(); adjustSize(); QTimer::singleShot(0, this, [this] { adjustSize(); }); }
    // scroll area is exactly as tall as the rows inside it (rows animate their own height)
    void syncRows() {
        int h = 0, n = 0;
        for (int i = 0; i < rows->count(); ++i) if (auto w = rows->itemAt(i)->widget()) { h += w->maximumHeight(); ++n; }
        if (n > 1) h += (n - 1) * kGap;
        sc->setFixedHeight(h); sc->setVisible(n > 0);
        layout()->activate(); adjustSize();
    }

    void setOpen(bool o) {
        if (o && shows.size() >= kMaxShows) return;
        box->open = o; panel->setVisible(o); box->setMinimumHeight(o ? 0 : 56); box->update();
        if (o) { flt->clear(); fillCatalog(); Catalog::get().refreshIfStale(); flt->setFocus(); }
        refit();
    }
    void fillCatalog() {
        if (!box->open) return;
        cat->clear(); QString f = flt->text().trimmed();
        for (auto& s : Catalog::get().items()) {
            if (watching(s.id) || (!f.isEmpty() && !s.t.contains(f, Qt::CaseInsensitive))) continue;
            QStringList sub; if (s.total) sub << QString("%1 episodes").arg(s.total); if (s.airing) sub << "airing";
            auto it = new QListWidgetItem(QIcon(covers.contains(s.id) ? covers[s.id] : tileFor(s.t)),
                                          s.t.toLower() + (sub.isEmpty() ? QString() : "\n" + sub.join(" \u2022 ")));
            it->setData(Qt::UserRole, s.id); it->setData(Qt::UserRole + 1, s.cover); cat->addItem(it);
        }
        if (!cat->count()) {
            auto it = new QListWidgetItem(Catalog::get().busy() ? "loading crunchyroll list..." : "nothing found");
            it->setFlags(Qt::NoItemFlags); cat->addItem(it);
        }
        QTimer::singleShot(0, this, [this] { loadVisible(); });
    }
    void add(int id) {
        if (watching(id) || shows.size() >= kMaxShows) return;
        for (auto& s : Catalog::get().items()) if (s.id == id) { shows.push_back(s); break; }
        save(); setOpen(false); rebuild(id);
    }
    // bouncy grow + fade-in for a freshly added row
    void popRow(QWidget* r) {
        auto fx = new QGraphicsOpacityEffect(r); fx->setOpacity(0); r->setGraphicsEffect(fx);
        r->setFixedHeight(1);
        auto a = new QVariantAnimation(r); a->setDuration(560); a->setStartValue(0.0); a->setEndValue(1.0); a->setEasingCurve(QEasingCurve::OutBack);
        connect(a, &QVariantAnimation::valueChanged, r, [this, r, fx](const QVariant& v) {
            qreal t = v.toReal();
            fx->setOpacity(qBound(0.0, t * 1.5, 1.0));
            r->setFixedHeight(qMax(1, int(kRowH * qMax(0.0, t))));
            syncRows();
        });
        connect(a, &QVariantAnimation::finished, r, [this, r] { r->setGraphicsEffect(nullptr); r->setFixedHeight(kRowH); syncRows(); });
        a->start(QAbstractAnimation::DeleteWhenStopped);
    }
    void rebuild(int popId = 0) {
        while (auto it = rows->takeAt(0)) { if (it->widget()) { it->widget()->hide(); it->widget()->deleteLater(); } delete it; }
        QWidget* popped = nullptr;
        for (int i = 0; i < shows.size(); ++i) {
            auto& s = shows[i];
            auto r = new QWidget; r->setObjectName("row"); r->setAttribute(Qt::WA_StyledBackground); r->setFixedHeight(kRowH);
            auto h = new QHBoxLayout(r); h->setContentsMargins(8, 8, 10, 8); h->setSpacing(10);
            auto cv = new QLabel; cv->setObjectName(QString("cv%1").arg(s.id)); cv->setFixedSize(40, 40); cv->setPixmap(coverFor(s));
            auto tv = new QVBoxLayout; tv->setSpacing(2);
            auto t = new ElideLabel(s.t); t->setObjectName("t");
            auto e = new ElideLabel(QString("episode %1/%2%3").arg(s.ep).arg(s.total ? QString::number(s.total) : "?")
                                        .arg(s.total && s.ep >= s.total ? "  \u2713" : "")); e->setObjectName("e");
            tv->addWidget(t); tv->addWidget(e);
            auto m = new QToolButton; m->setText("\u2212"); m->setObjectName("minus");
            auto pl = new QToolButton; pl->setText("+"); pl->setObjectName("plus");
            h->addWidget(cv); h->addLayout(tv, 1); h->addWidget(m); h->addWidget(pl);
            connect(m, &QToolButton::clicked, this, [this, i] { shows[i].ep = qMax(0, shows[i].ep - 1); save(); rebuild(); });
            connect(pl, &QToolButton::clicked, this, [this, i] {
                auto& s = shows[i]; s.ep = s.total ? qMin(s.total, s.ep + 1) : s.ep + 1; save(); rebuild();
            });
            r->setContextMenuPolicy(Qt::CustomContextMenu);
            connect(r, &QWidget::customContextMenuRequested, this, [this, i] {
                QMenu mm;
                if (!shows[i].url.isEmpty()) mm.addAction("open on crunchyroll", [this, i] { QDesktopServices::openUrl(QUrl(shows[i].url)); });
                mm.addAction("remove", [this, i] { shows.removeAt(i); save(); rebuild(); if (box->open) fillCatalog(); });
                mm.exec(QCursor::pos());
            });
            rows->addWidget(r);
            if (popId && s.id == popId) popped = r;
        }
        rows->addStretch(1);
        box->setVisible(shows.size() < kMaxShows);          // full list -> the dashed box is gone until you remove one
        if (shows.size() >= kMaxShows && box->open) setOpen(false);
        syncRows();
        if (popped) popRow(popped);
    }
    QString css() override {
        return "QScrollArea{background:transparent;border:none;} #host{background:transparent;}"
               "#row{background:rgba(255,255,255,22);border-radius:12px;} #t{font-weight:600;} #e{font-size:11px;color:#bfe;}"
               "QToolButton{border-radius:11px;min-width:22px;max-width:22px;min-height:22px;max-height:22px;font-weight:700;}"
               "#plus{background:ACC2;color:#0b2b25;border:none;} #minus{border:1px solid #ff7b8f;color:#ff7b8f;background:transparent;}"
               "#close{border:none;color:ACC2;font-size:16px;background:transparent;}"
               "QLineEdit{background:#f4f4ee;color:#222;border-radius:10px;padding:4px 8px;}"
               "QListWidget{background:transparent;outline:0;font-size:12px;font-weight:600;}"
               "QListWidget::item{padding:4px 6px;border-radius:10px;}"
               "QListWidget::item:hover{background:rgba(255,255,255,30);}"
               "QListWidget::item:selected{background:ACC;color:#1a1a1a;}";
    }
};

// ---------------------------------------------------------------- settings dialog
void openSettings() {
    static QPointer<QDialog> dlg;
    if (dlg) { dlg->raise(); dlg->activateWindow(); return; }
    auto d = new QDialog; d->setAttribute(Qt::WA_DeleteOnClose); dlg = d; d->setWindowTitle("BetterWidgets settings");
    auto& c = cfg(); auto tabs = new QTabWidget;

    auto colorBtn = [d](std::shared_ptr<QColor> col) {
        auto b = new QPushButton; auto paint = [b, col] { b->setStyleSheet("background:" + col->name() + ";min-height:22px;"); }; paint();
        QObject::connect(b, &QPushButton::clicked, d, [=] { QColor n = QColorDialog::getColor(*col, d); if (n.isValid()) { *col = n; paint(); } });
        return b;
    };
    auto acc = std::make_shared<QColor>(c.accent), acc2 = std::make_shared<QColor>(c.accent2);
    auto op = new QSlider(Qt::Horizontal); op->setRange(20, 100); op->setValue(c.opacity);
    auto rad = new QSlider(Qt::Horizontal); rad->setRange(0, 40); rad->setValue(c.radius);

    // font picker + "add font file" button (copies the file into the fonts folder, loads it now, and selects it)
    auto fc = new QComboBox;
    auto fillFonts = [fc](const QString& sel) { fc->clear(); fc->addItems(QFontDatabase::families()); fc->setCurrentText(sel); };
    fillFonts(c.font);
    auto addFont = new QPushButton("add font file (.ttf / .otf)...");
    QObject::connect(addFont, &QPushButton::clicked, d, [=] {
        QStringList files = QFileDialog::getOpenFileNames(d, "choose font files", QDir::homePath(), "fonts (*.ttf *.otf)");
        QString last;
        for (auto& f : files) {
            QString dst = fontsDir() + "/" + QFileInfo(f).fileName();
            if (f != dst) { QFile::remove(dst); if (!QFile::copy(f, dst)) dst = f; }
            int id = QFontDatabase::addApplicationFont(dst);
            if (id >= 0) { auto fam = QFontDatabase::applicationFontFamilies(id); if (!fam.isEmpty()) last = fam.first(); }
        }
        if (!last.isEmpty()) fillFonts(last);
        else if (!files.isEmpty()) QMessageBox::warning(d, "BetterWidgets", "could not load that font file.");
    });

    auto lock = new QCheckBox("lock widget positions"); lock->setChecked(c.locked);
    auto snap = new QCheckBox("snap widgets to grid while dragging (hold ALT to ignore)"); snap->setChecked(c.snap);
    auto gs = new QSpinBox; gs->setRange(5, 200); gs->setSuffix(" px"); gs->setValue(c.grid);
    auto mono = new QCheckBox("flat one-color app icons"); mono->setChecked(c.mono);
    auto sz = new QSlider(Qt::Horizontal); sz->setRange(50, 200); sz->setValue(c.size); sz->setToolTip("the app restarts to apply a new size");
    auto szl = new QLabel(QString::number(c.size) + "%"); szl->setMinimumWidth(42);
    QObject::connect(sz, &QSlider::valueChanged, szl, [szl](int v) { szl->setText(QString::number(v) + "%"); });
    auto szRow = new QWidget; auto szh = new QHBoxLayout(szRow); szh->setContentsMargins(0, 0, 0, 0); szh->addWidget(sz, 1); szh->addWidget(szl);
    auto look = new QWidget; auto f1 = new QFormLayout(look);
    f1->addRow("widget size (restarts app)", szRow);
    f1->addRow("accent (highlights)", colorBtn(acc)); f1->addRow("accent 2 (icons, graphs, buttons)", colorBtn(acc2));
    f1->addRow("opacity (all widgets)", op); f1->addRow("corner radius", rad); f1->addRow("font", fc); f1->addRow(addFont); f1->addRow(mono);
    f1->addRow(lock); f1->addRow(snap); f1->addRow("grid size", gs);
    auto openIni = new QPushButton("open settings file (betterwidgets.ini)");
    QObject::connect(openIni, &QPushButton::clicked, d, [] { QDesktopServices::openUrl(QUrl::fromLocalFile(cfgPath())); });
    f1->addRow(openIni);
    tabs->addTab(look, "look");

    auto wid = new QWidget; auto g2 = new QGridLayout(wid); QList<QCheckBox*> cbs; QList<QSpinBox*> sps;
    g2->addWidget(new QLabel("show"), 0, 0); g2->addWidget(new QLabel("own opacity"), 0, 1);
    int row = 1;
    for (auto w : g_widgets) {
        auto cb = new QCheckBox(w->id); cb->setChecked(w->isVisible()); cbs << cb;
        auto sp = new QSpinBox; sp->setRange(0, 100); sp->setSuffix("%"); sp->setSpecialValueText("global"); sp->setValue(c.wop.value(w->id, 0)); sps << sp;
        g2->addWidget(cb, row, 0); g2->addWidget(sp, row, 1); ++row;
    }
    g2->setRowStretch(row, 1); tabs->addTab(wid, "widgets");

    auto user = new QLineEdit(c.user); auto ref = new QSpinBox; ref->setRange(5, 600); ref->setSuffix(" min"); ref->setValue(c.refresh);
    auto h24 = new QCheckBox("24-hour clock"); h24->setChecked(c.h24); auto secs = new QCheckBox("show seconds"); secs->setChecked(c.secs);
    auto misc = new QWidget; auto f2 = new QFormLayout(misc);
    f2->addRow("github username", user); f2->addRow("refresh every", ref); f2->addRow(h24); f2->addRow(secs);
    tabs->addTab(misc, "github & clock");

    auto bb = new QDialogButtonBox(QDialogButtonBox::Apply | QDialogButtonBox::Close);
    auto v = new QVBoxLayout(d); v->addWidget(tabs); v->addWidget(bb);
    QObject::connect(bb, &QDialogButtonBox::rejected, d, &QDialog::close);
    QObject::connect(bb->button(QDialogButtonBox::Apply), &QPushButton::clicked, d, [=] {
        auto& c = cfg();
        c.size = sz->value();
        c.accent = *acc; c.accent2 = *acc2; c.opacity = op->value(); c.radius = rad->value(); c.font = fc->currentText();
        c.locked = lock->isChecked(); c.mono = mono->isChecked(); c.snap = snap->isChecked(); c.grid = gs->value();
        c.user = user->text().trimmed(); c.refresh = ref->value(); c.h24 = h24->isChecked(); c.secs = secs->isChecked();
        for (int i = 0; i < g_widgets.size(); ++i) {
            g_widgets[i]->setVisible(cbs[i]->isChecked()); QSettings().setValue("visible/" + g_widgets[i]->id, cbs[i]->isChecked());
            if (sps[i]->value() > 0) c.wop[g_widgets[i]->id] = sps[i]->value(); else c.wop.remove(g_widgets[i]->id);
        }
        saveCfg(); emit bus().changed();
        if (c.size != g_runSize) restartApp();      // a new size needs a fresh start
    });
    d->resize(440, 460); d->show();
}

// ---------------------------------------------------------------- main
int main(int argc, char** argv) {
    g_argv0 = argc > 0 ? argv[0] : "";
    QCoreApplication::setOrganizationName("BetterWidgets"); QCoreApplication::setApplicationName("BetterWidgets");
    migrateOldIni();
    g_runSize = earlySize();
    // widget size: 1.05 is the 100% look (about 60% of a 1080p screen) and the "size" setting scales it.
    // it has to be set before QApplication exists. (set QT_SCALE_FACTOR yourself to override the size setting)
    if (qEnvironmentVariableIsEmpty("QT_SCALE_FACTOR")) {
        qputenv("QT_SCALE_FACTOR", QByteArray::number(1.05 * g_runSize / 100.0, 'f', 3)); g_ownScale = true;
    }
    QApplication a(argc, argv);
    a.setQuitOnLastWindowClosed(false);
    QLocale::setDefault(QLocale(QLocale::English, QLocale::UnitedStates));      // everything english, whatever the system language is
    migrateOldSettings();
    loadFonts(); initCfg();

    // new default layout: clear saved positions once so the reference layout applies (drag widgets afterwards as you like)
    if (QSettings().value("layoutVer", 1).toInt() < kLayoutVersion) {
        for (auto& id : kIds) QSettings().remove("pos/" + id);
        QSettings().setValue("layoutVer", kLayoutVersion);
    }

    new Launcher; new Clock; new SysInfo; new Github; new Watching;
    for (auto w : g_widgets) if (QSettings().value("visible/" + w->id, true).toBool()) w->show();

    // hot-reload betterwidgets.ini whenever it is saved
    QFileSystemWatcher cw; QTimer cwT; cwT.setSingleShot(true); cwT.setInterval(250);
    auto watchCfg = [&] { if (!cw.files().contains(cfgPath())) cw.addPath(cfgPath()); };
    watchCfg();
    QObject::connect(&cw, &QFileSystemWatcher::fileChanged, &cwT, [&] { cwT.start(); });
    QObject::connect(&cwT, &QTimer::timeout, &cw, [&] {
        watchCfg(); QString before = cfgText(); loadCfgFile();
        if (cfgText() != before) emit bus().changed();
        if (cfg().size != g_runSize) restartApp();
    });

    QPixmap px(32, 32); px.fill(Qt::transparent);
    { QPainter p(&px); p.setRenderHint(QPainter::Antialiasing); p.setBrush(cfg().accent); p.setPen(Qt::NoPen); p.drawRoundedRect(4, 4, 24, 24, 8, 8); }
    QSystemTrayIcon tray{QIcon(px)}; QMenu menu;
    tray.setToolTip("BetterWidgets");
    menu.addAction("settings...", [] { openSettings(); });
    menu.addAction("open settings file", [] { QDesktopServices::openUrl(QUrl::fromLocalFile(cfgPath())); });
    menu.addAction("reset layout", [] { for (auto w : g_widgets) w->resetPos(); });
    menu.addAction("show all", [] { for (auto w : g_widgets) { w->show(); QSettings().setValue("visible/" + w->id, true); } });
    menu.addAction("hide all", [] { for (auto w : g_widgets) { w->hide(); QSettings().setValue("visible/" + w->id, false); } });
    menu.addSeparator(); menu.addAction("quit", &a, &QApplication::quit);
    tray.setContextMenu(&menu); tray.show();
    return a.exec();
}
